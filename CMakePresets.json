{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-native-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=native"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "gcc-base",
      "binaryDir": "${sourceDir}/build/gcc/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "inherits": "gcc-base",
      "binaryDir": "${sourceDir}/build/gcc/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/build/clang/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": "clang-base",
      "binaryDir": "${sourceDir}/build/clang/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-native-debug",
      "displayName": "GCC Native Debug (host CPU, Linux)",
      "inherits": ["gcc-base", "linux-native-base"],
      "binaryDir": "${sourceDir}/build/gcc-native/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-native-release",
      "displayName": "GCC Native Release (host CPU, Linux)",
      "inherits": ["gcc-base", "linux-native-base"],
      "binaryDir": "${sourceDir}/build/gcc-native/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-native-debug",
      "displayName": "Clang Native Debug (host CPU, Linux)",
      "inherits": ["clang-base", "linux-native-base"],
      "binaryDir": "${sourceDir}/build/clang-native/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-native-release",
      "displayName": "Clang Native Release (host CPU, Linux)",
      "inherits": ["clang-base", "linux-native-base"],
      "binaryDir": "${sourceDir}/build/clang-native/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WASM Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/wasm/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "gcc-native-debug",
      "configurePreset": "gcc-native-debug"
    },
    {
      "name": "gcc-native-release",
      "configurePreset": "gcc-native-release"
    },
    {
      "name": "clang-native-debug",
      "configurePreset": "clang-native-debug"
    },
    {
      "name": "clang-native-release",
      "configurePreset": "clang-native-release"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    }
  ]
}
